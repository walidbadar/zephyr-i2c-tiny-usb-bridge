# MCUboot with signature checking does not fit next to two image slots in the
# 128 KiB flash and 20 KiB RAM of the STM32F103. Images are still verified
# against their SHA-256 hash.
choice BOOT_SIGNATURE_TYPE
	default BOOT_SIGNATURE_TYPE_NONE if BOARD = "stm32_debug_probe"
endchoice

source "share/sysbuild/Kconfig"
