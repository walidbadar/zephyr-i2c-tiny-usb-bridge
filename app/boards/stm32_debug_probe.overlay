#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * The bus is bit-banged on the J2 header, SCL on PA3 and SDA on PA4. PA3 and
 * PA4 are tied to PA5 and PA7 on the board, which are left as inputs.
 *
 * The STM32F1 has no pull-ups on open-drain outputs: the bus needs external
 * pull-ups to 3.3 V (4.7 kOhm), unless the target board provides them.
 */
/ {
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
	};

	i2c-tiny-usb {
		compatible = "i2c-tiny-usb";
		i2c-bus = <&gpio_i2c>;
	};

	gpio_i2c: i2c {
		compatible = "gpio-i2c";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		scl-gpios = <&gpioa 3 GPIO_OPEN_DRAIN>;
		sda-gpios = <&gpioa 4 GPIO_OPEN_DRAIN>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

/* PA3 is the USART2 RX pin, the console stays on RTT */
&usart2 {
	status = "disabled";
};

&usb {
	disconnect-gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
};
