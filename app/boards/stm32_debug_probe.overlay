#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * The bus is bit-banged on the J2 header, SCL on PA3 and SDA on PA4. PA3 and
 * PA4 are tied to PA5 and PA7 on the board, which are left as inputs.
 *
 * The STM32F1 has no pull-ups on open-drain outputs: the bus needs external
 * pull-ups to 3.3 V (4.7 kOhm), unless the target board provides them.
 */
/ {
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
		zephyr,code-partition = &slot0_partition;
	};

	gpio_i2c: i2c {
		compatible = "gpio-i2c";
		clock-frequency = <I2C_BITRATE_FAST>;
		scl-gpios = <&gpioa 3 GPIO_OPEN_DRAIN>;
		sda-gpios = <&gpioa 4 GPIO_OPEN_DRAIN>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

/*
 * MCUboot flash layout for USB DFU. MCUboot without image signature checking
 * fits in 26 KiB. The secondary slot is one 1 KiB page larger than the
 * primary slot, as required by MCUboot's swap using offset mode.
 */
&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(26)>;
		};

		slot0_partition: partition@6800 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00006800 DT_SIZE_K(50)>;
		};

		slot1_partition: partition@13000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00013000 DT_SIZE_K(51)>;
		};
	};
};

/* PA3 is the USART2 RX pin, the console stays on RTT */
&usart2 {
	status = "disabled";
};

&i2c_tiny_usb {
	i2c-bus = <&gpio_i2c>;
};

&usb {
	disconnect-gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
};
