/*
 * I2C1 on PB6 (SCL) and PB7 (SDA), shared with the on-board LSM303
 * accelerometer (0x19) and magnetometer (0x1e). The board enumerates through
 * the USB USER connector.
 */

&i2c_tiny_usb {
	i2c-bus = <&i2c1>;
};
